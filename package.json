{
  "name": "drupal-ui-automation",
  "version": "1.0.0",
  "description": "Automated Drupal 10 UI testing platform with Playwright and interactive VNC login",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "docker-compose --profile test run --rm test npm run test:all",
    "test:watch": "NODE_ENV=test npx vitest",
    "test:unit": "docker-compose --profile test run --rm test npm run test:unit:only",
    "test:unit:only": "NODE_ENV=test npx vitest run tests/unit",
    "test:unit:host": "NODE_ENV=test npx vitest run tests/unit",
    "test:integration": "node tests/run-integration-tests.js",
    "test:integration:direct": "NODE_ENV=test npx vitest run tests/integration --no-file-parallelism",
    "test:all": "NODE_ENV=test npx vitest run",
    "test:container": "docker-compose --profile test run --rm test",
    "test:integration:container": "docker-compose --profile test run --rm test npm run test:integration:direct",
    "test:only": "NODE_ENV=test npx vitest run tests/integration"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "supertest": "^7.3.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "keywords": [
    "automation",
    "docker",
    "drupal",
    "playwright",
    "ui-testing",
    "vnc"
  ],
  "author": "",
  "license": "MIT"
}
